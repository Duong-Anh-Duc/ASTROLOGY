# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# Path (relative to project root) to the Google Service Account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/google-service-account.json

# Google Sheet ID — open the spreadsheet and copy from URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# IMPORTANT: share the sheet with the Service Account email (client_email in the JSON) as Editor.
GOOGLE_SHEET_ID=your_sheet_id_here

# Optional — run Playwright with a visible browser window for debugging
# Set to "false" to see the scraper in action, "true" or unset for headless mode.
PLAYWRIGHT_HEADLESS=true
